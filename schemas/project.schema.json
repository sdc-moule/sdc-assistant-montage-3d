{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Projet de consultation SDC 1.0",
  "type": "object",
  "required": ["schema_version", "assembly_id", "source_sha256", "occurrence_ids", "display", "camera"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "assembly_id": {"type": "string"},
    "source_sha256": {"type": "string"},
    "occurrence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "display": {
      "type": "object",
      "required": ["explode", "section", "sectionPosition", "inverse", "items"],
      "properties": {
        "explode": {"type": "number", "minimum": 0, "maximum": 100},
        "section": {"enum": ["", "XZ", "YZ", "XY"]},
        "sectionPosition": {"type": "number", "minimum": 0, "maximum": 100},
        "inverse": {"type": "boolean"},
        "items": {"type": "object", "additionalProperties": {"type": "object", "required": ["visible", "opacity", "comment"], "properties": {
          "visible": {"type": "boolean"}, "opacity": {"type": "number", "minimum": 0, "maximum": 1}, "comment": {"type": "string"}
        }}}
      }
    },
    "camera": {"type": "object", "required": ["position", "target"], "properties": {
      "position": {"$ref": "#/$defs/vector"}, "target": {"$ref": "#/$defs/vector"}
    }}
  },
  "$defs": {"vector": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}}
}
